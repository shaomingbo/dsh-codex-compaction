{
  "name": "dsh-codex-compaction",
  "version": "0.4.3",
  "description": "Official-basic Codex compaction with an optional account-owned native summarization seam and legacy structured reader; no core patches or duplicate login.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./provider": "./src/provider-entry.js",
    "./compaction": "./src/compaction.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-codex-compaction": "bin/install.js"
  },
  "files": [
    "src",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/ARCHITECTURE.md",
    "docs/CODEX_RUNTIME_V1.md",
    "docs/VALIDATION.md",
    "docs/RECOVERY_FIX.md",
    "docs/COMPACTION_BENEFIT.md",
    "docs/LONG_SESSION_STABILITY.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js && npm test && npm run test:legacy-a && npm run test:compaction-ab",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "experiment:compaction-ab": "node experiments/compaction-ab/run.js",
    "test:compaction-ab": "node --test experiments/compaction-ab/*.test.js",
    "test:legacy-a": "node --test experiments/compaction-ab/a-baseline/test/*.test.js",
    "test:accounts-integration": "node scripts/test-accounts.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaomingbo/dsh-codex-compaction.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "compaction"
  ],
  "author": "shaomingbo",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-authorization": "0.1.2-rc.1",
    "@deepseek-ai/dsh-command-compact": "0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.2-rc.1",
    "@earendil-works/pi-ai": "0.84.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
